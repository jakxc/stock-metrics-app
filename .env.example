# Alpha Vantage API Key
# Get your free API key from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_api_key_here

# API Data Configuration
# FORCE_MOCK_DATA: Set to 'true' to use mock data even in production
# USE_REAL_API: Set to 'true' to use real APIs in development (overrides default mock behavior)
# Default: Mock data in development, real data in production
FORCE_MOCK_DATA=false
USE_REAL_API=true

# Firebase Configuration
# Get these from your Firebase project settings
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_auth_domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_storage_bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# WebSocket Configuration for Live Stock Updates
NEXT_PUBLIC_STOCK_WS_URL="ws://localhost:8080"

# Optional: Finnhub API Key for real-time stock data
# Get a free API key at https://finnhub.io/
# If not set, the WebSocket server will use mock data
FINNHUB_API_KEY=your_finnhub_api_key_here

# WebSocket Server Ports
WS_PORT=8080
HEALTH_PORT=3001