{
  "name": "stocksapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "websocket": "node scripts/start-websocket.js",
    "dev:all": "concurrently \"npm run websocket\" \"npm run dev\"",
    "test:websocket": "node scripts/test-websocket.js",
    "test:env": "node scripts/test-environment-config.js",
    "test:api-config": "node scripts/test-api-config.js",
    "test:real-api": "node scripts/test-real-api.js",
    "dev:mock": "NODE_ENV=development FORCE_MOCK_DATA=true npm run dev",
    "dev:real": "NODE_ENV=development USE_REAL_API=true FORCE_MOCK_DATA=false npm run dev",
    "build:prod": "NODE_ENV=production npm run build"
  },
  "dependencies": {
    "@types/ws": "^8.18.2",
    "axios": "^1.20.0",
    "finnhub": "^2.0.15",
    "firebase": "^12.18.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io-client": "^4.8.4",
    "ws": "^8.22.0",
    "yahoo-finance2": "^4.0.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
