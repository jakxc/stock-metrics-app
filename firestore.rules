rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── savedSearches ──────────────────────────────────────────────────────
    // Each doc represents one stock a user has saved. Docs carry a `userId`
    // field set to the owner's auth uid (see app/components/StockSearch.tsx).
    // Only the owning, authenticated user may read, create, update, or
    // delete their own docs — no cross-user access, no anonymous access.
    match /savedSearches/{searchId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
